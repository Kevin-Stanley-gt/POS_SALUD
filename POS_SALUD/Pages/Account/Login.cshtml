@page
@model POS_SALUD.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS Farma</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Iconos de Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            :root {
                --brand-primary: #0b5e5c;
                --brand-dark: #084342;
            }

            body, html {
                height: 100%;
                margin: 0;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
                background-color: #ffffff;
            }

            .login-container {
                min-height: 100vh;
            }
            /* Panel izquierdo */
            .hero-side {
                background-color: var(--brand-dark);
                color: #ffffff;
                position: relative;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                overflow: hidden;
            }
            /* Tarjetas flotantes circulares */
            .hero-badge {
                background-color: rgba(255, 255, 255, 0.15);
                backdrop-filter: blur(4px);
                border-radius: 20px;
                padding: 6px 14px;
                font-size: 0.85rem;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

            .icon-circle-bg {
                position: relative;
                width: 260px;
                height: 260px;
                border-radius: 50%;
                border: 1px solid rgba(255, 255, 255, 0.12);
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto;
            }

                .icon-circle-bg::before {
                    content: "";
                    position: absolute;
                    width: 340px;
                    height: 340px;
                    border-radius: 50%;
                    border: 1px solid rgba(255, 255, 255, 0.05);
                }

            .center-cross-box {
                width: 130px;
                height: 130px;
                background-color: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 28px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 3rem;
            }

            .tag-floating-inventario {
                position: absolute;
                top: 25px;
                right: -20px;
            }

            .tag-floating-ventas {
                position: absolute;
                bottom: 30px;
                left: -35px;
            }
            /* Estilos de inputs y botón */
            .form-control:focus {
                border-color: var(--brand-primary);
                box-shadow: 0 0 0 0.25rem rgba(11, 94, 92, 0.15);
            }

            .btn-brand {
                background-color: var(--brand-primary);
                border-color: var(--brand-primary);
                color: #ffffff;
                transition: all 0.2s ease-in-out;
            }

                .btn-brand:hover {
                    background-color: #084e4c;
                    border-color: #084e4c;
                    color: #ffffff;
                }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0 login-container">
            <!-- Columna Izquierda: Identidad y Arte -->
            <div class="col-lg-5 d-none d-lg-flex hero-side p-5">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-5">
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="background: rgba(255,255,255,0.15); width: 38px; height: 38px;">
                            <i class="bi bi-plus-lg fs-5"></i>
                        </div>
                        <span class="fs-5 fw-bold tracking-wide">POS Farma</span>
                    </div>

                    <div class="mt-5 pt-3">
                        <span class="text-uppercase small fw-semibold text-white-50" style="letter-spacing: 1px;">Gestión para tu farmacia</span>
                        <h1 class="display-5 fw-bold mt-2 mb-3">Más claridad.<br />Mejor atención.</h1>
                        <p class="text-white-50 fs-6 pe-4" style="max-width: 420px;">
                            Ventas, inventario y movimientos en un solo lugar. Todo listo para concentrarte en lo importante.
                        </p>
                    </div>
                </div>

                <!-- Gráfico de Círculos y Módulos -->
                <div class="my-auto py-4">
                    <div class="icon-circle-bg">
                        <div class="center-cross-box">
                            <i class="bi bi-plus-lg text-white-50"></i>
                        </div>
                        <span class="hero-badge tag-floating-inventario">
                            <i class="bi bi-boxes"></i> Inventario
                        </span>
                        <span class="hero-badge tag-floating-ventas">
                            <i class="bi bi-basket2"></i> Ventas
                        </span>
                    </div>
                </div>

                <div class="small text-white-50">
                    POS Farma · Gestión simple, atención cercana
                </div>
            </div>

            <!-- Columna Derecha: Formulario -->
            <div class="col-lg-7 d-flex align-items-center justify-content-center p-4 p-md-5">
                <div style="width: 100%; max-width: 410px;">
                    <div class="mb-4">
                        <h2 class="fw-bold text-dark mb-2">Te damos la bienvenida</h2>
                        <p class="text-secondary small">Inicia sesión para continuar en POS Farma.</p>
                    </div>

                    @if (Model.MensajeError is not null)
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>@Model.MensajeError</div>
                        </div>
                    }

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label small fw-medium text-secondary">Correo electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Input.Email" class="form-control border-start-0 ps-0 py-2" placeholder="usuario@dominio.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label small fw-medium text-secondary">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Input.Password" type="password" class="form-control border-start-0 ps-0 py-2" placeholder="Ingresa tu contraseña" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-brand w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-medium">
                            <i class="bi bi-arrow-right"></i> Entrar
                        </button>

                        <div class="mt-4 pt-2 text-center text-muted small d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-shield-check text-muted"></i>
                            <span>Usa las credenciales asignadas para acceder a tu sucursal.</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>