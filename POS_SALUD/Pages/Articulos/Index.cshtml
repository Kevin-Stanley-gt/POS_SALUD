@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model POS_SALUD.Pages.Articulos.IndexModel
@{
    ViewData["Title"] = "Artículos";
}

<style>
    :root {
        --brand-color: #0b5e5c;
        --brand-hover: #084342;
    }

    .brand-btn-primary {
        background-color: var(--brand-color);
        border-color: var(--brand-color);
        color: #ffffff;
        font-weight: 500;
        border-radius: 8px;
    }

        .brand-btn-primary:hover {
            background-color: var(--brand-hover);
            border-color: var(--brand-hover);
            color: #ffffff;
        }

    .art-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    .table-art thead th {
        background-color: #ffffff;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.9rem 1.25rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .table-art tbody td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        font-size: 0.88rem;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9;
    }

    .table-art tbody tr:last-child td {
        border-bottom: none;
    }

    .filter-input {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        font-size: 0.9rem;
    }

        .filter-input:focus {
            border-color: var(--brand-color);
            box-shadow: 0 0 0 0.2rem rgba(11, 94, 92, 0.12);
        }

    .btn-more-options {
        color: #64748b;
        border: none;
        background: transparent;
        padding: 4px 8px;
        border-radius: 6px;
    }

        .btn-more-options:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }

    .info-callout {
        color: #475569;
        font-size: 0.88rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Artículos</h2>
        <p class="text-secondary small mb-0">Administra el catálogo y la clasificación de los productos.</p>
    </div>
    <div>
        <button type="button" class="btn brand-btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoArticulo">
            <i class="bi bi-plus-lg"></i>
            <span>Nuevo artículo</span>
        </button>
    </div>
</div>

<!-- Filtros de búsqueda -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <label class="form-label small fw-semibold text-secondary mb-1">Buscar artículo</label>
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0 text-muted">
                <i class="bi bi-search"></i>
            </span>
            <input type="text"
                   id="inputFiltroArticulo"
                   class="form-control border-start-0 filter-input ps-0"
                   placeholder="Buscar por código o nombre..."
                   autocomplete="off" />
        </div>
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label small fw-semibold text-secondary mb-1">Genérico</label>
        <select id="selectFiltroGenerico" class="form-select filter-input">
            <option value="">Todos los genéricos</option>
            @foreach (var g in Model.Genericos)
            {
                <option value="@g.Nombre.ToLowerInvariant()">@g.Nombre</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label small fw-semibold text-secondary mb-1">Laboratorio</label>
        <select id="selectFiltroLaboratorio" class="form-select filter-input">
            <option value="">Todos los laboratorios</option>
            @foreach (var l in Model.Laboratorios)
            {
                <option value="@l.Nombre.ToLowerInvariant()">@l.Nombre</option>
            }
        </select>
    </div>
</div>

<!-- Cabecera de listado -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <h6 class="fw-bold text-dark mb-0">Artículos registrados</h6>
    <span class="text-muted small" id="contadorArticulos">@Model.Articulos.Count artículos</span>
</div>

<!-- Tabla de Artículos -->
<div class="art-card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-art mb-0" id="tablaArticulos">
            <thead>
                <tr>
                    <th style="min-width: 150px;">Código</th>
                    <th style="min-width: 280px;">Nombre</th>
                    <th style="min-width: 180px;">Genérico</th>
                    <th style="min-width: 180px;">Laboratorio</th>
                    <th class="text-end pe-4" style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Articulos.Any())
                {
                    <tr id="filaSinArticulos">
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-capsule fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No hay artículos registrados en el catálogo.
                        </td>
                    </tr>
                }
                @foreach (var a in Model.Articulos)
                {
                    <tr class="articulo-row"
                        data-codigo="@(a.CodigoBarras?.ToLowerInvariant() ?? "")"
                        data-nombre="@(a.Nombre?.ToLowerInvariant() ?? "")"
                        data-generico="@(a.Generico?.Nombre?.ToLowerInvariant() ?? "")"
                        data-laboratorio="@(a.Laboratorio?.Nombre?.ToLowerInvariant() ?? "")">
                        <td class="font-monospace text-secondary fw-semibold">
                            @(string.IsNullOrWhiteSpace(a.CodigoBarras) ? "—" : a.CodigoBarras)
                        </td>
                        <td class="fw-semibold text-dark">
                            @a.Nombre
                        </td>
                        <td class="text-secondary text-uppercase small">
                            @(a.Generico?.Nombre ?? "—")
                        </td>
                        <td class="text-secondary text-uppercase small">
                            @(a.Laboratorio?.Nombre ?? "—")
                        </td>
                        <td class="text-end pe-4">
                            <button type="button" class="btn-more-options" title="Opciones">
                                <i class="bi bi-three-dots fs-5"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pie de tabla con conteo dinámico -->
    <div class="px-4 py-3 bg-light border-top text-muted small" id="pieTablaArticulos">
        Mostrando <span id="articulosVisibles">@Model.Articulos.Count</span> de @Model.Articulos.Count artículos
    </div>
</div>

<!-- Nota informativa inferior -->
<div class="info-callout mb-4">
    <i class="bi bi-info-circle text-secondary fs-5"></i>
    <span>El catálogo define el artículo. Las existencias, los costos y los vencimientos se consultan en Inventario por lotes.</span>
</div>

<!-- Modal Nuevo Artículo -->
<div class="modal fade" id="modalNuevoArticulo" tabindex="-1" aria-labelledby="modalNuevoArticuloLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 14px;">
            <form method="post">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="modalNuevoArticuloLabel">Nuevo artículo</h5>
                        <p class="text-muted small mb-0">Completa la ficha técnica para registrar el medicamento o insumo.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CodigoBarras" class="form-label small fw-semibold text-secondary">Código de barras</label>
                            <input asp-for="Input.CodigoBarras" class="form-control" placeholder="Ej. 740100123456" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Nombre" class="form-label small fw-semibold text-secondary">Nombre comercial</label>
                            <input asp-for="Input.Nombre" class="form-control" placeholder="Ej. Amoxicilina 500mg" />
                            <span asp-validation-for="Input.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.IdGenerico" class="form-label small fw-semibold text-secondary">Genérico</label>
                            <select asp-for="Input.IdGenerico" class="form-select" asp-items="@(new SelectList(Model.Genericos, nameof(POS_SALUD.Data.Entities.Generico.IdGenerico), nameof(POS_SALUD.Data.Entities.Generico.Nombre)))">
                                <option value="">-- Seleccionar Genérico --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.IdLaboratorio" class="form-label small fw-semibold text-secondary">Laboratorio</label>
                            <select asp-for="Input.IdLaboratorio" class="form-select" asp-items="@(new SelectList(Model.Laboratorios, nameof(POS_SALUD.Data.Entities.Laboratorio.IdLaboratorio), nameof(POS_SALUD.Data.Entities.Laboratorio.Nombre)))">
                                <option value="">-- Seleccionar Laboratorio --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.PrecioBase" class="form-label small fw-semibold text-secondary">Precio base</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">Q</span>
                                <input asp-for="Input.PrecioBase" class="form-control" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-md-4">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="Input.RequiereReceta" class="form-check-input" type="checkbox" role="switch" id="switchReceta" />
                                <label class="form-check-label small fw-semibold text-secondary ms-2" for="switchReceta">
                                    ¿Requiere prescripción / receta médica?
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn brand-btn-primary px-4">Guardar artículo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputTexto = document.getElementById("inputFiltroArticulo");
            const selectGenerico = document.getElementById("selectFiltroGenerico");
            const selectLaboratorio = document.getElementById("selectFiltroLaboratorio");
            const filas = document.querySelectorAll(".articulo-row");
            const spanVisibles = document.getElementById("articulosVisibles");

            // Si viene una búsqueda desde la barra global (?buscar=...)
            const urlParams = new URLSearchParams(window.location.search);
            const queryUrl = urlParams.get('buscar');
            if (queryUrl) {
                inputTexto.value = queryUrl;
            }

            function filtrar() {
                const query = inputTexto.value.trim().toLowerCase();
                const genFiltro = selectGenerico.value;
                const labFiltro = selectLaboratorio.value;
                let visibles = 0;

                filas.forEach(fila => {
                    const codigo = fila.getAttribute("data-codigo");
                    const nombre = fila.getAttribute("data-nombre");
                    const generico = fila.getAttribute("data-generico");
                    const laboratorio = fila.getAttribute("data-laboratorio");

                    const coincideTexto = codigo.includes(query) || nombre.includes(query);
                    const coincideGen = !genFiltro || generico.includes(genFiltro);
                    const coincideLab = !labFiltro || laboratorio.includes(labFiltro);

                    if (coincideTexto && coincideGen && coincideLab) {
                        fila.style.display = "";
                        visibles++;
                    } else {
                        fila.style.display = "none";
                    }
                });

                if (spanVisibles) {
                    spanVisibles.textContent = visibles;
                }
            }

            inputTexto.addEventListener("input", filtrar);
            selectGenerico.addEventListener("change", filtrar);
            selectLaboratorio.addEventListener("change", filtrar);

            // Ejecutar si había valor por defecto o parámetro en URL
            filtrar();
        });
    </script>
}

@if (ModelState.ErrorCount > 0)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            new bootstrap.Modal(document.getElementById("modalNuevoArticulo")).show();
        });
    </script>
}