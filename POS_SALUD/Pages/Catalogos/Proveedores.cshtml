@page
@model POS_SALUD.Pages.Catalogos.ProveedoresModel
@{
    ViewData["Title"] = "Proveedores";
}

<style>
    .brand-btn-primary {
        background-color: #0b5e5c;
        border-color: #0b5e5c;
        color: #ffffff;
        font-weight: 500;
        border-radius: 8px;
    }

        .brand-btn-primary:hover {
            background-color: #084342;
            border-color: #084342;
            color: #ffffff;
        }

    .table-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    .table-custom thead th {
        background-color: #f8fafc;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .table-custom tbody td {
        padding: 0.85rem 1rem;
        vertical-align: middle;
        font-size: 0.88rem;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9;
    }
</style>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Proveedores</h2>
        <p class="text-secondary small mb-0">Gestión de distribuidores para el registro de compras e inventario.</p>
    </div>
    <button type="button" class="btn brand-btn-primary d-inline-flex align-items-center gap-2 py-2 px-3" data-bs-toggle="modal" data-bs-target="#modalNuevo">
        <i class="bi bi-truck"></i>
        <span>Nuevo proveedor</span>
    </button>
</div>

<div class="table-card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-custom mb-0">
            <thead>
                <tr>
                    <th class="ps-4">NIT</th>
                    <th>Razón Social</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Estado</th>
                    <th class="pe-4 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">No hay proveedores registrados.</td>
                    </tr>
                }
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td class="ps-4 font-monospace text-secondary">@p.Nit</td>
                        <td class="fw-semibold text-dark">@p.RazonSocial</td>
                        <td class="text-secondary">@(p.Telefono ?? "—")</td>
                        <td class="text-secondary">@(p.Email ?? "—")</td>
                        <td>
                            @if (p.Activo)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactivo</span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalToggle@(p.IdProveedor)">
                                @(p.Activo ? "Desactivar" : "Activar")
                            </button>

                            <div class="modal fade" id="modalToggle@(p.IdProveedor)" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                                        <div class="modal-header border-bottom-0 pb-0">
                                            <h5 class="modal-title fw-bold">@(p.Activo ? "Desactivar" : "Activar") proveedor</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                        </div>
                                        <div class="modal-body text-start py-3">
                                            ¿Confirma cambiar el estado de <strong>@p.RazonSocial</strong>?
                                        </div>
                                        <div class="modal-footer border-top-0">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                            <form method="post" asp-page-handler="Toggle" asp-route-id="@p.IdProveedor" class="d-inline">
                                                <button type="submit" class="btn brand-btn-primary">Confirmar</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalNuevo" tabindex="-1" aria-labelledby="modalNuevoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 14px;">
            <form method="post">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="modalNuevoLabel">Nuevo proveedor</h5>
                        <p class="text-muted small mb-0">Ingresa los datos fiscales y de contacto del distribuidor.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Input.Nit" class="form-label small fw-semibold text-secondary">NIT</label>
                            <input asp-for="Input.Nit" class="form-control" placeholder="Ej. 9876543-2" />
                            <span asp-validation-for="Input.Nit" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Input.RazonSocial" class="form-label small fw-semibold text-secondary">Razón social / Empresa</label>
                            <input asp-for="Input.RazonSocial" class="form-control" placeholder="Nombre de la distribuidora" />
                            <span asp-validation-for="Input.RazonSocial" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Telefono" class="form-label small fw-semibold text-secondary">Teléfono</label>
                            <input asp-for="Input.Telefono" class="form-control" placeholder="Teléfono de contacto" />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Input.Email" class="form-label small fw-semibold text-secondary">Correo electrónico</label>
                            <input asp-for="Input.Email" class="form-control" placeholder="proveedor@empresa.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn brand-btn-primary px-4">Guardar proveedor</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (ModelState.ErrorCount > 0)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            new bootstrap.Modal(document.getElementById("modalNuevo")).show();
        });
    </script>
}