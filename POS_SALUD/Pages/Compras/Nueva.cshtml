@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model POS_SALUD.Pages.Compras.NuevaModel
@{
    ViewData["Title"] = "Registrar compra";
}

<style>
    :root {
        --brand-color: #0b5e5c;
        --brand-hover: #084342;
    }

    .compra-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.5rem;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        font-size: 0.88rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--brand-color);
            box-shadow: 0 0 0 0.2rem rgba(11, 94, 92, 0.12);
        }

    .btn-brand-primary {
        background-color: var(--brand-color);
        border-color: var(--brand-color);
        color: #ffffff;
        font-weight: 500;
        border-radius: 8px;
    }

        .btn-brand-primary:hover {
            background-color: var(--brand-hover);
            border-color: var(--brand-hover);
            color: #ffffff;
        }

    .total-box-card {
        background-color: var(--brand-color);
        color: #ffffff;
        border-radius: 14px;
        padding: 1.5rem;
    }

    .total-box-amount {
        font-size: 2.25rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .search-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        max-height: 280px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        display: none;
    }

    .search-item {
        padding: 0.65rem 1rem;
        cursor: pointer;
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.15s;
    }

        .search-item:last-child {
            border-bottom: none;
        }

        .search-item:hover {
            background-color: #f8fafc;
        }

    .table-compras thead th {
        background-color: #f8fafc;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.75rem 0.75rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .table-compras tbody td {
        padding: 0.75rem 0.5rem;
        vertical-align: middle;
        font-size: 0.88rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .btn-trash-line {
        color: #94a3b8;
        border: none;
        background: transparent;
        padding: 4px 6px;
        border-radius: 6px;
        transition: all 0.15s ease-in-out;
    }

        .btn-trash-line:hover {
            color: #dc3545;
            background-color: #fee2e2;
        }
</style>

<div class="mb-4">
    <h2 class="fw-bold text-dark mb-1">Registrar compra</h2>
    <p class="text-secondary small mb-0">Organiza el documento e ingresa los artículos recibidos por lote.</p>
</div>

@if (Model.MensajeError is not null)
{
    <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-x-circle-fill"></i>
        <div>@Model.MensajeError</div>
    </div>
}

@if (Model.CompraRegistrada is not null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small d-flex align-items-center justify-content-between mb-4" role="alert">
        <div>
            <i class="bi bi-check-circle-fill me-2"></i>
            Compra <strong>@Model.CompraRegistrada.NumeroDocumento</strong> registrada exitosamente. Total: <strong>Q @Model.CompraRegistrada.Total.ToString("N2")</strong>
        </div>
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<form method="post" id="formCompra">
    <div class="row g-4">
        <!-- COLUMNA PRINCIPAL (70%) -->
        <div class="col-12 col-lg-8">
            <!-- Datos del Documento -->
            <div class="compra-card shadow-sm mb-4">
                <h6 class="fw-bold text-dark mb-3">Datos del documento</h6>
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <label asp-for="Input.IdTipoDocumento" class="form-label small fw-semibold text-secondary mb-1">Tipo doc.</label>
                        <select asp-for="Input.IdTipoDocumento" class="form-select py-2" asp-items="@(new SelectList(Model.TiposDocumento, nameof(POS_SALUD.Data.Entities.TipoDocumento.IdTipoDocumento), nameof(POS_SALUD.Data.Entities.TipoDocumento.Nombre)))"></select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label asp-for="Input.IdProveedor" class="form-label small fw-semibold text-secondary mb-1">Proveedor</label>
                        <select asp-for="Input.IdProveedor" class="form-select py-2" asp-items="@(new SelectList(Model.Proveedores, nameof(POS_SALUD.Data.Entities.Proveedor.IdProveedor), nameof(POS_SALUD.Data.Entities.Proveedor.RazonSocial)))"></select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label asp-for="Input.NumeroDocumento" class="form-label small fw-semibold text-secondary mb-1">N.º Documento</label>
                        <input asp-for="Input.NumeroDocumento" class="form-control py-2" placeholder="Ej. FC-12345" required />
                    </div>
                    <div class="col-12 col-md-3">
                        <label asp-for="Input.Observaciones" class="form-label small fw-semibold text-secondary mb-1">Observaciones</label>
                        <input asp-for="Input.Observaciones" class="form-control py-2" placeholder="Opcional..." />
                    </div>
                </div>
            </div>

            <!-- Detalle de la Compra con Buscador -->
            <div class="compra-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Artículos a ingresar</h6>
                        <span class="text-secondary small">Busca el medicamento para registrar su lote y costo</span>
                    </div>
                    <span class="text-muted small" id="contadorLineasTexto">0 artículo(s)</span>
                </div>

                <!-- Buscador de Artículos -->
                <div class="mb-3 position-relative">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               id="inputBuscarArticulo"
                               class="form-control border-start-0 ps-0 py-2"
                               placeholder="Buscar artículo por nombre o código para agregar..."
                               autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary px-3" id="btnBuscarArticulo">
                            Buscar
                        </button>
                    </div>

                    <!-- Desplegable dinámico de artículos -->
                    <div id="dropdownResultadosArticulos" class="search-dropdown-menu"></div>
                </div>

                <!-- Tabla de Artículos Agregados -->
                <div class="border rounded-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover table-compras mb-0" id="tablaLineasCompra">
                            <thead>
                                <tr>
                                    <th class="ps-3" style="min-width: 200px;">Artículo</th>
                                    <th style="min-width: 130px;">Lote</th>
                                    <th style="min-width: 135px;">Vencimiento</th>
                                    <th class="text-end" style="width: 110px;">Costo U.</th>
                                    <th class="text-center" style="width: 85px;">Cant.</th>
                                    <th class="text-end" style="width: 95px;">Subtotal</th>
                                    <th class="text-end pe-3" style="width: 45px;"></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyLineas">
                                <tr id="filaVaciaCompra">
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <div class="py-3">
                                            <i class="bi bi-box-seam fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                            <span class="fw-semibold text-dark fs-6">Aún no hay artículos en la compra</span>
                                            <div class="small">Utiliza el buscador superior para seleccionar y agregar productos al documento.</div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Contenedor invisible para enviar el Model Binding a ASP.NET Core -->
                <div id="hiddenInputsCompra"></div>
            </div>
        </div>

        <!-- COLUMNA LATERAL (30% - Resumen estilo POS) -->
        <div class="col-12 col-lg-4">
            <!-- Tarjeta Total Esmeralda -->
            <div class="total-box-card shadow-sm mb-4">
                <span class="text-white-50 small fw-bold text-uppercase">Total de la compra</span>
                <div class="total-box-amount mt-1 mb-2">Q <span id="lblTotalCompra">0.00</span></div>
                <div class="text-white-50 small" id="lblSubtotalDetalle">0 artículos agregados</div>
            </div>

            <!-- Tarjeta Resumen y Acciones -->
            <div class="compra-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-secondary small">Artículos distintos:</span>
                    <span class="fw-bold text-dark" id="lblArticulosDistintos">0</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-secondary small">Unidades totales:</span>
                    <span class="fw-bold text-dark" id="lblUnidadesTotales">0</span>
                </div>

                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-brand-primary py-2 d-inline-flex align-items-center justify-content-center gap-2" id="btnAbrirModalConfirmar">
                        <i class="bi bi-check2-circle fs-5"></i>
                        <span>Registrar compra</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary py-2" id="btnLimpiarCompra">
                        Cancelar / Limpiar
                    </button>
                </div>

                <div class="text-muted text-center small mt-3">
                    Revisa las cantidades y costos antes de asentar el documento.
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Confirmación -->
    <div class="modal fade" id="modalConfirmarCompra" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-dark">Confirmar compra</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-secondary mb-0">
                        ¿Desea registrar esta compra? Los lotes ingresados se integrarán automáticamente al inventario activo de tu sucursal.
                    </p>
                </div>
                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-brand-primary px-4" id="btnConfirmarSubmit">Sí, registrar compra</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Catálogo disponible enviado por el backend
            const catalogoArticulos = [
                        @foreach (var a in Model.Articulos)
                {
                    <text>{
                            id: @a.IdArticulo,
                            nombre: "@Html.Raw(a.Nombre.Replace("\"", "\\\""))",
                            codigo: "@(a.CodigoBarras ?? "")",
                            costoBase: @(a.PrecioBase > 0 ? a.PrecioBase : 0)
                                    }, </text>
                            }
                        ];

                const inputBuscar = document.getElementById("inputBuscarArticulo");
                const btnBuscar = document.getElementById("btnBuscarArticulo");
                const dropdown = document.getElementById("dropdownResultadosArticulos");
                const tbody = document.getElementById("tbodyLineas");
                const filaVacia = document.getElementById("filaVaciaCompra");
                const hiddenContainer = document.getElementById("hiddenInputsCompra");
                const form = document.getElementById("formCompra");

                const lblTotal = document.getElementById("lblTotalCompra");
                const lblSubtotalDetalle = document.getElementById("lblSubtotalDetalle");
                const lblArticulosDistintos = document.getElementById("lblArticulosDistintos");
                const lblUnidadesTotales = document.getElementById("lblUnidadesTotales");
                const contadorLineasTexto = document.getElementById("contadorLineasTexto");

                let lineas = [];

                // Buscar al teclear
                function ejecutarBusqueda() {
                    const term = inputBuscar.value.trim().toLowerCase();
                    if (term.length === 0) {
                        dropdown.style.display = "none";
                        dropdown.innerHTML = "";
                        return;
                    }

                    const filtrados = catalogoArticulos.filter(a =>
                        a.nombre.toLowerCase().includes(term) || a.codigo.toLowerCase().includes(term)
                    );

                    if (filtrados.length === 0) {
                        dropdown.innerHTML = `<div class="p-3 text-center text-muted small">No se encontró ningún artículo para "${escapeHtml(term)}"</div>`;
                    } else {
                        dropdown.innerHTML = filtrados.map(a => `
                                    <div class="search-item d-flex justify-content-between align-items-center" data-id="${a.id}">
                                        <div>
                                            <span class="fw-semibold text-dark">${a.nombre}</span>
                                            <div class="text-muted small">Código: <strong>${a.codigo || "Sin código"}</strong></div>
                                        </div>
                                        <span class="badge bg-light text-dark border">Q ${a.costoBase.toFixed(2)}</span>
                                    </div>
                                `).join("");
                    }
                    dropdown.style.display = "block";
                }

                inputBuscar.addEventListener("input", ejecutarBusqueda);
                btnBuscar.addEventListener("click", ejecutarBusqueda);

                // Seleccionar producto del dropdown
                dropdown.addEventListener("click", function (e) {
                    const item = e.target.closest(".search-item");
                    if (!item) return;

                    const id = parseInt(item.getAttribute("data-id"));
                    const art = catalogoArticulos.find(a => a.id === id);

                    if (art) {
                        // Generar fecha sugerida de 2 años adelante
                        const fechaDefault = new Date();
                        fechaDefault.setFullYear(fechaDefault.getFullYear() + 2);
                        const fechaStr = fechaDefault.toISOString().split('T')[0];

                        lineas.push({
                            idArticulo: art.id,
                            nombre: art.nombre,
                            lote: "",
                            vencimiento: fechaStr,
                            costo: art.costoBase,
                            cantidad: 1
                        });
                        renderizarTabla();
                    }

                    inputBuscar.value = "";
                    dropdown.style.display = "none";
                    dropdown.innerHTML = "";
                });

                // Cerrar menú al hacer click afuera
                document.addEventListener("click", function (e) {
                    if (!inputBuscar.contains(e.target) && !dropdown.contains(e.target)) {
                        dropdown.style.display = "none";
                    }
                });

                function renderizarTabla() {
                    if (lineas.length === 0) {
                        tbody.innerHTML = "";
                        tbody.appendChild(filaVacia);
                        contadorLineasTexto.textContent = "0 artículo(s)";
                        actualizarResumen();
                        return;
                    }

                    tbody.innerHTML = lineas.map((item, index) => {
                        const subtotal = (item.costo * item.cantidad);
                        return `
                                    <tr>
                                        <td class="ps-3 fw-semibold text-dark text-truncate" style="max-width: 220px;" title="${item.nombre}">
                                            ${item.nombre}
                                        </td>
                                        <td>
                                            <input type="text"
                                                   class="form-control form-control-sm input-lote"
                                                   placeholder="Lote..."
                                                   value="${escapeHtml(item.lote)}"
                                                   data-index="${index}"
                                                   required />
                                        </td>
                                        <td>
                                            <input type="date"
                                                   class="form-control form-control-sm input-vence"
                                                   value="${item.vencimiento}"
                                                   data-index="${index}"
                                                   required />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control form-control-sm text-end input-costo"
                                                   value="${item.costo.toFixed(2)}"
                                                   data-index="${index}" />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   min="1"
                                                   class="form-control form-control-sm text-center input-cant"
                                                   value="${item.cantidad}"
                                                   data-index="${index}" />
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            Q ${subtotal.toFixed(2)}
                                        </td>
                                        <td class="text-end pe-3">
                                            <button type="button" class="btn-trash-line btn-quitar-linea" data-index="${index}" title="Quitar">
                                                <i class="bi bi-trash fs-5 pointer-events-none"></i>
                                            </button>
                                        </td>
                                    </tr>
                                `;
                    }).join("");

                    contadorLineasTexto.textContent = `${lineas.length} artículo(s)`;
                    actualizarResumen();
                }

                // Cambios de valores directos en la tabla
                tbody.addEventListener("input", function (e) {
                    const idx = parseInt(e.target.getAttribute("data-index"));
                    if (isNaN(idx)) return;

                    if (e.target.classList.contains("input-lote")) {
                        lineas[idx].lote = e.target.value;
                    } else if (e.target.classList.contains("input-vence")) {
                        lineas[idx].vencimiento = e.target.value;
                    } else if (e.target.classList.contains("input-costo")) {
                        lineas[idx].costo = parseFloat(e.target.value) || 0;
                        actualizarSubtotalFila(e.target.closest("tr"), lineas[idx]);
                        actualizarResumen();
                    } else if (e.target.classList.contains("input-cant")) {
                        let cant = parseInt(e.target.value) || 1;
                        if (cant < 1) cant = 1;
                        lineas[idx].cantidad = cant;
                        actualizarSubtotalFila(e.target.closest("tr"), lineas[idx]);
                        actualizarResumen();
                    }
                });

                function actualizarSubtotalFila(tr, item) {
                    const subtotal = item.costo * item.cantidad;
                    tr.children[5].textContent = `Q ${subtotal.toFixed(2)}`;
                }

                // Eliminar fila
                tbody.addEventListener("click", function (e) {
                    const btn = e.target.closest(".btn-quitar-linea");
                    if (btn) {
                        const idx = parseInt(btn.getAttribute("data-index"));
                        lineas.splice(idx, 1);
                        renderizarTabla();
                    }
                });

                function actualizarResumen() {
                    let total = 0;
                    let unidades = 0;

                    lineas.forEach(l => {
                        total += (l.costo * l.cantidad);
                        unidades += l.cantidad;
                    });

                    lblTotal.textContent = total.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    lblSubtotalDetalle.textContent = `${lineas.length} artículos en la compra`;
                    lblArticulosDistintos.textContent = lineas.length;
                    lblUnidadesTotales.textContent = unidades;
                }

                // Abrir Modal de Confirmación con validación
                document.getElementById("btnAbrirModalConfirmar").addEventListener("click", function () {
                    if (lineas.length === 0) {
                        alert("Debes agregar al menos un artículo a la compra.");
                        return;
                    }

                    // Validar que todas las líneas tengan lote asignado
                    const sinLote = lineas.some(l => !l.lote || l.lote.trim() === "");
                    if (sinLote) {
                        alert("Todos los artículos agregados deben tener un número de lote.");
                        return;
                    }

                    const docNum = document.getElementById("Input_NumeroDocumento");
                    if (docNum && (!docNum.value || docNum.value.trim() === "")) {
                        alert("Por favor ingresa el número de documento de la compra.");
                        docNum.focus();
                        return;
                    }

                    new bootstrap.Modal(document.getElementById("modalConfirmarCompra")).show();
                });

                // Enviar formulario (Generar campos hidden que espera ASP.NET Core)
                form.addEventListener("submit", function () {
                    hiddenContainer.innerHTML = "";
                    lineas.forEach((item, i) => {
                        hiddenContainer.innerHTML += `
                                    <input type="hidden" name="Input.Lineas[${i}].IdArticulo" value="${item.idArticulo}" />
                                    <input type="hidden" name="Input.Lineas[${i}].Lote" value="${escapeHtml(item.lote)}" />
                                    <input type="hidden" name="Input.Lineas[${i}].FechaVencimiento" value="${item.vencimiento}" />
                                    <input type="hidden" name="Input.Lineas[${i}].CostoUnitario" value="${item.costo}" />
                                    <input type="hidden" name="Input.Lineas[${i}].Cantidad" value="${item.cantidad}" />
                                `;
                    });
                });

                // Botón Limpiar
                document.getElementById("btnLimpiarCompra").addEventListener("click", function () {
                    form.reset();
                    lineas = [];
                    renderizarTabla();
                });

                function escapeHtml(text) {
                    return (text || "").toString().replace(/&/g, "&").replace(/</g, "<").replace(/>/g, ">");
                }
            });
        </script>
    }