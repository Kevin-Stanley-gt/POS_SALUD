@page
@model POS_SALUD.Pages.Catalogos.ClientesModel
@{
    ViewData["Title"] = "Clientes";
}

<style>
    .brand-btn-primary {
        background-color: #0b5e5c;
        border-color: #0b5e5c;
        color: #ffffff;
        font-weight: 500;
        border-radius: 8px;
    }

        .brand-btn-primary:hover {
            background-color: #084342;
            border-color: #084342;
            color: #ffffff;
        }

    .table-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    .table-custom thead th {
        background-color: #f8fafc;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .table-custom tbody td {
        padding: 0.85rem 1rem;
        vertical-align: middle;
        font-size: 0.88rem;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9;
    }
</style>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Clientes</h2>
        <p class="text-secondary small mb-0">Listado de clientes para facturación y ventas en sucursal.</p>
    </div>
    <button type="button" class="btn brand-btn-primary d-inline-flex align-items-center gap-2 py-2 px-3" data-bs-toggle="modal" data-bs-target="#modalNuevo">
        <i class="bi bi-person-plus"></i>
        <span>Nuevo cliente</span>
    </button>
</div>

<div class="table-card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-custom mb-0">
            <thead>
                <tr>
                    <th class="ps-4">NIT</th>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th class="pe-4 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">No hay clientes registrados.</td>
                    </tr>
                }
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td class="ps-4 font-monospace text-secondary">@(string.IsNullOrWhiteSpace(c.Nit) ? "C/F" : c.Nit)</td>
                        <td class="fw-semibold text-dark">@c.Nombre</td>
                        <td class="text-secondary">@(string.IsNullOrWhiteSpace(c.Direccion) ? "Ciudad" : c.Direccion)</td>
                        <td class="text-secondary">@(c.Telefono ?? "—")</td>
                        <td>
                            @if (c.Activo)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactivo</span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalToggle@(c.IdCliente)">
                                @(c.Activo ? "Desactivar" : "Activar")
                            </button>

                            <div class="modal fade" id="modalToggle@(c.IdCliente)" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                                        <div class="modal-header border-bottom-0 pb-0">
                                            <h5 class="modal-title fw-bold">@(c.Activo ? "Desactivar" : "Activar") cliente</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                        </div>
                                        <div class="modal-body text-start py-3">
                                            ¿Confirma que desea cambiar el estado de <strong>@c.Nombre</strong>?
                                        </div>
                                        <div class="modal-footer border-top-0">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                            <form method="post" asp-page-handler="Toggle" asp-route-id="@c.IdCliente" class="d-inline">
                                                <button type="submit" class="btn brand-btn-primary">Confirmar</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalNuevo" tabindex="-1" aria-labelledby="modalNuevoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 14px;">
            <form method="post">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="modalNuevoLabel">Nuevo cliente</h5>
                        <p class="text-muted small mb-0">Registra un nuevo cliente para comprobantes y ventas.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Input.Nit" class="form-label small fw-semibold text-secondary">NIT</label>
                            <input asp-for="Input.Nit" class="form-control" placeholder="Ej. 1234567-8 o C/F" />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Input.Nombre" class="form-label small fw-semibold text-secondary">Nombre o Razón Social</label>
                            <input asp-for="Input.Nombre" class="form-control" placeholder="Nombre completo" />
                            <span asp-validation-for="Input.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Input.Direccion" class="form-label small fw-semibold text-secondary">Dirección</label>
                            <input asp-for="Input.Direccion" class="form-control" placeholder="Dirección de entrega o fiscal" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Telefono" class="form-label small fw-semibold text-secondary">Teléfono</label>
                            <input asp-for="Input.Telefono" class="form-control" placeholder="Número de contacto" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn brand-btn-primary px-4">Guardar cliente</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (ModelState.ErrorCount > 0)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            new bootstrap.Modal(document.getElementById("modalNuevo")).show();
        });
    </script>
}