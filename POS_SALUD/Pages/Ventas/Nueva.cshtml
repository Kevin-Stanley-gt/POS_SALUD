@page
@model POS_SALUD.Pages.Ventas.NuevaModel
@{
    ViewData["Title"] = "Nueva venta";
    var esDevolucion = Model.Input.TipoOperacion == NuevaModel.OperacionDevolucion;
    var totalVenta = Model.Input.Lineas.Sum(l => l.PrecioUnitario * l.Cantidad);
}
<div class="page-header">
    <h1>Punto de venta</h1>
</div>

@if (Model.JornadaActiva is null)
{
    <div class="alert alert-warning">No tiene una jornada abierta. <a asp-page="/Jornada/Index">Abrir jornada</a> antes de registrar ventas.</div>
}
@if (Model.MensajeError is not null)
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}
@if (Model.VentaRegistrada is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @(Model.VentaRegistrada.TipoVenta == NuevaModel.OperacionDevolucion ? "Devolución" : "Venta") @Model.VentaRegistrada.NumeroDocumento registrada. Total: @Model.VentaRegistrada.Total.ToString("N2")
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<form method="post" id="formVenta">
    <input type="hidden" asp-for="Input.IdCliente" />
    <input type="hidden" asp-for="Input.IdVentaOrigen" />
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Tipo de operación</label>
                    <select asp-for="Input.TipoOperacion" class="form-select" onchange="document.getElementById('formVenta').requestSubmit(document.getElementById('btnCambiarTipo'))">
                        <option value="@NuevaModel.OperacionVenta">Venta</option>
                        <option value="@NuevaModel.OperacionDevolucion">Devolución</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Tipo de documento</label>
                    <select asp-for="Input.IdTipoDocumento" class="form-select" asp-items="@(new SelectList(Model.TiposDocumento.Where(t => t.Codigo == (esDevolucion ? "DV" : "FV")), nameof(POS_SALUD.Data.Entities.TipoDocumento.IdTipoDocumento), nameof(POS_SALUD.Data.Entities.TipoDocumento.Nombre)))"></select>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">1. Cliente</div>
        <div class="card-body">
            <div class="input-group mb-2">
                <input asp-for="Input.BusquedaCliente" class="form-control" placeholder="Buscar cliente por nombre" />
                <button type="submit" class="btn btn-outline-primary" asp-page-handler="BuscarCliente">Buscar</button>
            </div>
            @if (Model.ClientesEncontrados.Count > 0)
            {
                <div class="list-group mb-2">
                    @foreach (var c in Model.ClientesEncontrados)
                    {
                        <button type="submit" class="list-group-item list-group-item-action" asp-page-handler="SeleccionarCliente" asp-route-idCliente="@c.IdCliente">@c.Nombre</button>
                    }
                </div>
            }
            @if (Model.ClienteSeleccionado is not null)
            {
                <div class="alert alert-info mb-0">Cliente: <strong>@Model.ClienteSeleccionado.Nombre</strong></div>
            }
            else if (!esDevolucion)
            {
                <small class="text-muted">Sin cliente seleccionado: consumidor final.</small>
            }
        </div>
    </div>

    @if (esDevolucion && Model.ClienteSeleccionado is not null)
    {
        <div class="card mb-3">
            <div class="card-header">2. Venta a devolver</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr><th class="ps-3">Documento</th><th>Fecha</th><th class="text-end">Total</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.VentasCliente)
                        {
                            <tr class="@(v.IdVenta == Model.Input.IdVentaOrigen ? "table-primary" : "")">
                                <td class="ps-3">@v.NumeroDocumento</td>
                                <td>@v.FechaDocumento.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">@v.Total.ToString("N2")</td>
                                <td class="text-end">
                                    <button type="submit" class="btn btn-sm btn-outline-primary" asp-page-handler="SeleccionarVenta" asp-route-idVenta="@v.IdVenta">Seleccionar</button>
                                </td>
                            </tr>
                        }
                        @if (Model.VentasCliente.Count == 0)
                        {
                            <tr><td colspan="4" class="ps-3 text-muted">Este cliente no tiene ventas registradas.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!esDevolucion || Model.VentaOrigenSeleccionada is not null)
    {
        <div class="card mb-3">
            <div class="card-header">@(esDevolucion ? "3. Artículos a devolver" : "2. Artículos")</div>
            @if (!esDevolucion)
            {
                <div class="card-body border-bottom">
                    <div class="input-group">
                        <input asp-for="Input.BusquedaArticulo" class="form-control" placeholder="Buscar artículo por nombre" />
                        <button type="submit" class="btn btn-outline-primary" asp-page-handler="BuscarArticulo">Buscar</button>
                    </div>
                    @if (Model.ArticulosEncontrados.Count > 0)
                    {
                        <div class="list-group mt-2">
                            @foreach (var a in Model.ArticulosEncontrados)
                            {
                                <button type="submit" class="list-group-item list-group-item-action d-flex justify-content-between" asp-page-handler="AgregarArticulo" asp-route-idArticulo="@a.IdArticulo">
                                    <span>@a.Nombre</span><span>@a.PrecioBase.ToString("N2")</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Artículo</th>
                            <th class="text-end" style="width:120px">Cantidad</th>
                            @if (esDevolucion)
                            {
                                <th class="text-end" style="width:160px">Disponible a devolver</th>
                            }
                            <th class="text-end" style="width:120px">Precio</th>
                            <th class="text-end" style="width:120px">Subtotal</th>
                            @if (!esDevolucion)
                            {
                                <th style="width:200px"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Input.Lineas.Count; i++)
                        {
                            var linea = Model.Input.Lineas[i];
                            <tr>
                                <td class="ps-3">
                                    @linea.NombreArticulo
                                    <input type="hidden" name="Input.Lineas[@i].IdArticulo" value="@linea.IdArticulo" />
                                    <input type="hidden" name="Input.Lineas[@i].IdDetalleVenta" value="@linea.IdDetalleVenta" />
                                    <input type="hidden" name="Input.Lineas[@i].NombreArticulo" value="@linea.NombreArticulo" />
                                    <input type="hidden" name="Input.Lineas[@i].PrecioUnitario" value="@linea.PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="Input.Lineas[@i].Cantidad" value="@linea.Cantidad" />
                                </td>
                                <td class="text-end">@linea.Cantidad</td>
                                @if (esDevolucion)
                                {
                                    <td class="text-end">@(linea.IdDetalleVenta is int idDet ? Model.CantidadDisponible.GetValueOrDefault(idDet) : 0)</td>
                                }
                                <td class="text-end">@linea.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end">@((linea.PrecioUnitario * linea.Cantidad).ToString("N2"))</td>
                                @if (!esDevolucion)
                                {
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalCantidad" data-id="@linea.IdArticulo" data-nombre="@linea.NombreArticulo" data-cantidad="@linea.Cantidad">Modificar</button>
                                        <button type="submit" class="btn btn-sm btn-outline-danger" asp-page-handler="QuitarArticulo" asp-route-idArticulo="@linea.IdArticulo">Quitar</button>
                                    </td>
                                }
                            </tr>
                        }
                        @if (Model.Input.Lineas.Count == 0)
                        {
                            <tr><td colspan="6" class="ps-3 text-muted">Sin artículos.</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="@(esDevolucion ? 4 : 3)" class="text-end">Total</th>
                            <th class="text-end">@totalVenta.ToString("N2")</th>
                            @if (!esDevolucion)
                            {
                                <th></th>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="card-body d-flex justify-content-end">
                @if (esDevolucion)
                {
                    <button type="submit" class="btn btn-danger" asp-page-handler="Registrar" onclick="return confirm('¿Registrar la devolución de todos los artículos disponibles?');">Registrar devolución</button>
                }
                else
                {
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalConfirmarVenta">Registrar venta</button>
                }
            </div>
        </div>
    }

    @if (!esDevolucion)
    {
        <div class="modal fade" id="modalCantidad">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalCantidadLabel">Modificar cantidad</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2" id="modalCantidadArticulo"></p>
                        name="idArticuloModal" id="inputIdArticuloModal"
                        <label class="form-label" for="inputNuevaCantidad">Nueva cantidad</label>
                        <input type="number" min="1" name="cantidadNueva" class="form-control" id="inputNuevaCantidad" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" id="btnGuardarCantidad" asp-page-handler="ModificarCantidad">Guardar</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalConfirmarVenta" tabindex="-1" aria-labelledby="modalConfirmarVentaLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalConfirmarVentaLabel">Confirmar venta</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Desea registrar la venta con los artículos seleccionados? Esta acción descontará existencias de los lotes FEFO.</p>
                        <div class="row g-2">
                            <div class="col-6">
                                <label asp-for="Input.MontoEfectivo" class="form-label">Pago en efectivo</label>
                                <input asp-for="Input.MontoEfectivo" class="form-control" type="number" step="0.01" min="0" id="inputMontoEfectivo" />
                            </div>
                            <div class="col-6">
                                <label asp-for="Input.MontoTarjeta" class="form-label">Pago con tarjeta</label>
                                <input asp-for="Input.MontoTarjeta" class="form-control" type="number" step="0.01" min="0" id="inputMontoTarjeta" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success" asp-page-handler="Registrar">Sí, registrar</button>
                    </div>
                </div>
            </div>
        </div>
    }
    <button type="submit" id="btnCambiarTipo" class="d-none" asp-page-handler="CambiarTipo"></button>
</form>

@section Scripts {
    <script>
        (function () {
            var modalCantidad = document.getElementById('modalCantidad');
            if (modalCantidad) {
                modalCantidad.addEventListener('show.bs.modal', function (e) {
                    var btn = e.relatedTarget;
                    document.getElementById('modalCantidadArticulo').textContent = btn.getAttribute('data-nombre');
                    document.getElementById('inputNuevaCantidad').value = btn.getAttribute('data-cantidad');
                    document.getElementById('inputIdArticuloModal').value = btn.getAttribute('data-id');
                });
            }

            var inputEfectivo = document.getElementById('inputMontoEfectivo');
            var inputTarjeta = document.getElementById('inputMontoTarjeta');
            var modalConfirmar = document.getElementById('modalConfirmarVenta');
            if (modalConfirmar) {
                modalConfirmar.addEventListener('show.bs.modal', function () {
                    inputEfectivo.value = '@totalVenta.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)';
                    inputTarjeta.value = '0.00';
                });
            }
        })();
    </script>
}
