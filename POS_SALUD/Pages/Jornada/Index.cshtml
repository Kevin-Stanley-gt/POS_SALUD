@page
@model POS_SALUD.Pages.Jornada.IndexModel
@{
    ViewData["Title"] = "Jornada de caja";
}

<div class="page-header">
    <h1>Jornada de caja</h1>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

@if (TempData["Resumen"] is string resumen)
{
    <div class="alert alert-success">@resumen</div>
}

@if (Model.JornadaActiva is null)
{
    <div class="card">
        <h2>Abrir jornada</h2>
        <form method="post" asp-page-handler="Abrir">
            <div class="mb-3">
                <label asp-for="Abrir.FondoInicial" class="form-label">Fondo inicial en efectivo</label>
                <input asp-for="Abrir.FondoInicial" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <button type="submit" class="btn btn-primary">Abrir jornada</button>
        </form>
    </div>
}
else
{
    <div class="card">
        <h2>Jornada activa</h2>
        <p>Apertura: @Model.JornadaActiva.FechaApertura.ToString("dd/MM/yyyy HH:mm")</p>
        <p>Fondo inicial: @Model.JornadaActiva.FondoInicial.ToString("0.00")</p>

        <h3>Cerrar jornada</h3>
        <form method="post" asp-page-handler="Cerrar">
            <div class="mb-3">
                <label asp-for="Cerrar.EfectivoDeclarado" class="form-label">Efectivo declarado</label>
                <input asp-for="Cerrar.EfectivoDeclarado" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <div class="mb-3">
                <label asp-for="Cerrar.TarjetaDeclarada" class="form-label">Tarjeta declarada</label>
                <input asp-for="Cerrar.TarjetaDeclarada" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <button type="submit" class="btn btn-danger">Cerrar jornada</button>
        </form>
    </div>
}
