@page
@model POS_SALUD.Pages.Traslados.RecepcionModel
@{
    ViewData["Title"] = "Recepción de traslados";
}

<style>
    :root {
        --brand-color: #0b5e5c;
        --brand-hover: #084342;
    }

    .recepcion-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        overflow: hidden;
    }

    .btn-brand-primary {
        background-color: var(--brand-color);
        border-color: var(--brand-color);
        color: #ffffff;
        font-weight: 500;
        border-radius: 8px;
    }

        .btn-brand-primary:hover {
            background-color: var(--brand-hover);
            border-color: var(--brand-hover);
            color: #ffffff;
        }

    .table-recepcion thead th {
        background-color: #f8fafc;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .table-recepcion tbody td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        font-size: 0.88rem;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9;
    }

    .table-recepcion tbody tr:last-child td {
        border-bottom: none;
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Recepción de mercadería</h2>
        <p class="text-secondary small mb-0">Revisa y confirma el ingreso de envíos provenientes de otras sucursales.</p>
    </div>
    <div>
        <button type="button" class="btn btn-outline-secondary bg-white d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm fw-medium text-dark" onclick="window.location.reload();">
            <i class="bi bi-arrow-clockwise fs-5"></i>
            <span>Actualizar</span>
        </button>
    </div>
</div>

@if (Model.MensajeError is not null)
{
    <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-x-circle-fill"></i>
        <div>@Model.MensajeError</div>
    </div>
}

@if (Model.MensajeOk is not null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small d-flex align-items-center justify-content-between mb-4" role="alert">
        <div>
            <i class="bi bi-check-circle-fill me-2"></i>
            @Model.MensajeOk
        </div>
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Tarjeta: Envíos en tránsito -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="fw-bold text-dark mb-0">Envíos pendientes de ingresar</h5>
    <span class="text-muted small">@Model.TrasladosPendientes.Count traslado(s) en camino</span>
</div>

<div class="recepcion-card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-recepcion mb-0">
            <thead>
                <tr>
                    <th class="ps-4" style="width: 90px;">N.º Envío</th>
                    <th>Sucursal de origen</th>
                    <th>Enviado por</th>
                    <th>Fecha de despacho</th>
                    <th>Observaciones</th>
                    <th class="pe-4 text-end" style="width: 220px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TrasladosPendientes.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="text-muted my-3">
                                <div class="rounded-3 bg-light d-inline-flex align-items-center justify-content-center p-3 mb-2 border">
                                    <i class="bi bi-truck fs-4 text-secondary opacity-75"></i>
                                </div>
                                <div class="fw-bold text-dark fs-6">No hay traslados pendientes</div>
                                <span class="small">Cuando otra sucursal te despache mercadería, aparecerá listada en esta sección.</span>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var t in Model.TrasladosPendientes)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-secondary">#@t.IdTraslado</td>
                        <td class="fw-semibold text-dark">
                            <i class="bi bi-shop me-1 text-muted"></i> @t.SucursalOrigen
                        </td>
                        <td class="text-secondary">@t.UsuarioEnvia</td>
                        <td class="text-secondary">@(t.FechaEnvio?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td class="text-muted small text-truncate" style="max-width: 200px;">
                            @(string.IsNullOrWhiteSpace(t.Observaciones) ? "Sin observaciones" : t.Observaciones)
                        </td>
                        <td class="pe-4 text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 me-1" data-bs-toggle="modal" data-bs-target="#modalDetalle@(t.IdTraslado)">
                                <i class="bi bi-eye me-1"></i> Ver detalle
                            </button>
                            <button type="button" class="btn btn-sm btn-brand-primary rounded-pill px-3 py-1" data-bs-toggle="modal" data-bs-target="#modalRecibir@(t.IdTraslado)">
                                <i class="bi bi-box-seam me-1"></i> Recibir
                            </button>

                            <!-- Modal: Ver Detalle del Envío -->
                            <div class="modal fade" id="modalDetalle@(t.IdTraslado)" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                                        <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                                            <div>
                                                <h5 class="modal-title fw-bold text-dark">Detalle del traslado #@t.IdTraslado</h5>
                                                <p class="text-muted small mb-0">Despachado desde @t.SucursalOrigen</p>
                                            </div>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                        </div>
                                        <div class="modal-body p-4 text-start">
                                            <div class="table-responsive border rounded-3">
                                                <table class="table table-sm table-hover mb-0">
                                                    <thead class="bg-light">
                                                        <tr>
                                                            <th class="ps-3 py-2">Artículo</th>
                                                            <th class="py-2">Lote</th>
                                                            <th class="py-2">Vencimiento</th>
                                                            <th class="text-end pe-3 py-2">Cantidad enviada</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var d in t.Detalles)
                                                        {
                                                            <tr>
                                                                <td class="ps-3 fw-medium">@d.Articulo</td>
                                                                <td class="font-monospace text-secondary">@d.Lote</td>
                                                                <td class="text-secondary">@d.Vencimiento</td>
                                                                <td class="text-end pe-3 fw-bold text-dark">@d.CantidadEnviada unids.</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-top-0 px-4 pb-4">
                                            <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cerrar</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal: Confirmar Recepción -->
                            <div class="modal fade" id="modalRecibir@(t.IdTraslado)" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                                        <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                                            <h5 class="modal-title fw-bold text-dark">Confirmar recepción #@t.IdTraslado</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                        </div>
                                        <div class="modal-body p-4 text-start">
                                            <div class="p-3 bg-light rounded-3 mb-3 border">
                                                <div class="small text-secondary">Origen: <strong>@t.SucursalOrigen</strong></div>
                                                <div class="small text-secondary">Total de ítems: <strong>@t.Detalles.Sum(x => x.CantidadEnviada) unidades</strong></div>
                                            </div>
                                            <p class="text-secondary small mb-0">
                                                ¿Confirma que la mercadería física ha llegado a la sucursal? Esta acción ingresará de inmediato los lotes a tu inventario.
                                            </p>
                                        </div>
                                        <div class="modal-footer border-top-0 px-4 pb-4">
                                            <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                                            <form method="post" asp-page-handler="Recibir" asp-route-id="@t.IdTraslado" class="d-inline">
                                                <button type="submit" class="btn btn-brand-primary px-4">Confirmar e ingresar</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>