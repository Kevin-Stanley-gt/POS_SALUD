@page
@model POS_SALUD.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - POS Farma</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="card border-0 shadow-sm p-4 p-md-5 text-center" style="max-width: 480px; border-radius: 16px;">
        <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
             style="width: 72px; height: 72px; background-color: #fee2e2; color: #dc3545;">
            <i class="bi bi-exclamation-triangle-fill fs-1"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Ocurrió un error inesperado</h3>
        <p class="text-secondary small mb-4">
            Se ha producido un problema al procesar la solicitud. Si el problema persiste, contacta al administrador del sistema.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="alert alert-secondary py-2 small font-monospace mb-4">
                ID de solicitud: <strong>@Model.RequestId</strong>
            </div>
        }

        <div>
            <a href="/" class="btn btn-primary px-4 py-2" style="background-color: #0b5e5c; border-color: #0b5e5c; border-radius: 8px;">
                <i class="bi bi-house me-1"></i> Regresar al panel principal
            </a>
        </div>
    </div>
</body>
</html>