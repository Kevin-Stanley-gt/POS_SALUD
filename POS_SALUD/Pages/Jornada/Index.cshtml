@page
@model POS_SALUD.Pages.Jornada.IndexModel
@{
    ViewData["Title"] = "Jornada de caja";
}

<style>
    .brand-btn-primary {
        background-color: #0b5e5c;
        border-color: #0b5e5c;
        color: #ffffff;
        font-weight: 500;
        border-radius: 8px;
        transition: background-color 0.15s ease;
    }

        .brand-btn-primary:hover {
            background-color: #084342;
            border-color: #084342;
            color: #ffffff;
        }

    .status-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
    }

    .module-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.75rem;
    }

    .icon-box-status {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background-color: #f1f5f9;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .icon-box-active {
        background-color: #e6f3f2;
        color: #0b5e5c;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }

        .summary-row:last-child {
            border-bottom: none;
        }
</style>

<div class="mb-4">
    <h2 class="fw-bold text-dark mb-1">Jornada de caja</h2>
    <p class="text-secondary small mb-0">Abre tu jornada y verifica el efectivo antes de cerrar.</p>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>@Model.MensajeError</div>
    </div>
}

@if (TempData["Resumen"] is string resumen)
{
    <div class="alert alert-success py-2 small d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div>@resumen</div>
    </div>
}

<!-- Tarjeta de Estado Superior -->
<div class="status-card shadow-sm mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box-status @(Model.JornadaActiva != null ? "icon-box-active" : "")">
                <i class="bi @(Model.JornadaActiva != null ? "bi-wallet2" : "bi-wallet")"></i>
            </div>
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    @(Model.JornadaActiva != null ? "Jornada en curso" : "Sin jornada activa")
                </h5>
                <p class="text-muted small mb-0">
                    @(Model.JornadaActiva != null
                        ? $"Abierta el {Model.JornadaActiva.FechaApertura:dd/MM/yyyy} a las {Model.JornadaActiva.FechaApertura:HH:mm} hrs"
                        : "Registra el fondo inicial para comenzar a operar la caja.")
                </p>
            </div>
        </div>
        <div>
            @if (Model.JornadaActiva != null)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-medium">
                    <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> Caja abierta
                </span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill fw-medium">
                    Pendiente de apertura
                </span>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    @if (Model.JornadaActiva is null)
    {
        <!-- Panel Izquierdo: Formulario de Apertura -->
        <div class="col-12 col-lg-7">
            <div class="module-card shadow-sm h-100">
                <h5 class="fw-bold text-dark mb-1">Apertura de caja</h5>
                <p class="text-secondary small mb-4">Comienza una nueva jornada con tu fondo inicial.</p>

                <form method="post" asp-page-handler="Abrir">
                    <div class="mb-3">
                        <label asp-for="Abrir.FondoInicial" class="form-label small fw-semibold text-secondary">Monto de apertura</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">Q</span>
                            <input asp-for="Abrir.FondoInicial"
                                   class="form-control py-2"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00"
                                   required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary">Observaciones de apertura</label>
                        <textarea class="form-control" rows="3" placeholder="Agrega una nota, si es necesario"></textarea>
                    </div>

                    <button type="submit" class="btn brand-btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-unlock"></i>
                        <span>Abrir jornada</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Panel Derecho: Resumen Deshabilitado y Cierre Bloqueado -->
        <div class="col-12 col-lg-5">
            <div class="d-flex flex-column gap-4">
                <div class="module-card shadow-sm">
                    <h5 class="fw-bold text-dark mb-3">Resumen de la jornada</h5>
                    <div class="summary-row">
                        <span class="text-secondary">Monto de apertura</span>
                        <span class="fw-semibold text-dark">Q 0.00</span>
                    </div>
                    <div class="summary-row">
                        <span class="text-secondary">Ventas registradas</span>
                        <span class="fw-semibold text-dark">Q 0.00</span>
                    </div>
                    <div class="summary-row pt-3 mt-2 border-top">
                        <span class="fw-bold text-dark">Efectivo esperado</span>
                        <span class="fw-bold text-dark fs-5">Q 0.00</span>
                    </div>
                </div>

                <div class="module-card shadow-sm bg-light-subtle">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold text-muted mb-0">Cierre de caja</h5>
                        <i class="bi bi-lock text-muted fs-5"></i>
                    </div>
                    <p class="text-muted small mb-0">
                        Al finalizar el turno, registra el efectivo y tarjeta para contrastar con las ventas del sistema.
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Panel Izquierdo: Cierre de Caja Activo -->
        <div class="col-12 col-lg-7">
            <div class="module-card shadow-sm h-100">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <h5 class="fw-bold text-dark mb-0">Cerrar jornada</h5>
                    <a asp-page="/Jornada/Corte" asp-route-id="@Model.JornadaActiva.IdJornada" target="_blank" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 rounded-pill px-3">
                        <i class="bi bi-printer"></i>
                        <span>Imprimir corte preliminar</span>
                    </a>
                </div>
                <p class="text-secondary small mb-4">Ingresa el total físico contado en caja para conciliar la jornada.</p>

                <form method="post" asp-page-handler="Cerrar">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Cerrar.EfectivoDeclarado" class="form-label small fw-semibold text-secondary">Efectivo contado / declarado</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">Q</span>
                                <input asp-for="Cerrar.EfectivoDeclarado"
                                       class="form-control py-2"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00"
                                       required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cerrar.TarjetaDeclarada" class="form-label small fw-semibold text-secondary">Tarjeta declarada (POS)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">Q</span>
                                <input asp-for="Cerrar.TarjetaDeclarada"
                                       class="form-control py-2"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00"
                                       required />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 fw-medium">
                        <i class="bi bi-lock-fill"></i>
                        <span>Confirmar cierre de caja</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Panel Derecho: Datos de la Caja Actual -->
        <div class="col-12 col-lg-5">
            <div class="module-card shadow-sm h-100">
                <h5 class="fw-bold text-dark mb-3">Resumen de la jornada activa</h5>

                <div class="summary-row">
                    <span class="text-secondary">Fecha y hora apertura</span>
                    <span class="fw-semibold text-dark">@Model.JornadaActiva.FechaApertura.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="summary-row">
                    <span class="text-secondary">Fondo inicial en caja</span>
                    <span class="fw-semibold text-dark">Q @Model.JornadaActiva.FondoInicial.ToString("N2")</span>
                </div>

                <div class="p-3 mt-4 bg-light rounded-3 border">
                    <div class="d-flex align-items-center gap-2 mb-1 text-primary" style="color: #0b5e5c !important;">
                        <i class="bi bi-info-circle-fill"></i>
                        <span class="fw-semibold small">Operación continua</span>
                    </div>
                    <p class="text-muted small mb-0">
                        Todas las ventas cobradas en el Punto de Venta se registrarán automáticamente dentro de esta jornada.
                    </p>
                </div>
            </div>
        </div>
    }
</div>